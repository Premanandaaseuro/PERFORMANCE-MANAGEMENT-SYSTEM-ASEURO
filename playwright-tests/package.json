{
  "name": "pms-playwright-automation-tests",
  "version": "1.0.0",
  "description": "Enterprise-level Playwright Automated Testing Suite for Performance Management System (PMS)",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:auth": "playwright test --grep @auth",
    "test:hr": "playwright test --grep @hr",
    "test:manager": "playwright test --grep @manager",
    "test:employee": "playwright test --grep @employee",
    "test:api": "playwright test --grep @api",
    "test:database": "playwright test --grep @database",
    "test:security": "playwright test --grep @security",
    "test:ui": "playwright test --grep @ui",
    "test:responsive": "playwright test --grep @responsive",
    "test:accessibility": "playwright test --grep @accessibility",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit"
  },
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "pms",
    "e2e",
    "api",
    "database"
  ],
  "author": "Aseuro Technologies",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "typescript": "^5.7.2"
  }
}
